{
  "manifest_version": 3,
  "name": "Riptide",
  "version": "1.0",
  "description": "Hand a signed-in Safari tab back to your paired agent.",
  "icons": {
    "48": "riptide-icon-48.png",
    "64": "riptide-icon-64.png",
    "96": "riptide-icon-96.png",
    "128": "riptide-icon-128.png",
    "256": "riptide-icon-256.png",
    "512": "riptide-icon-512.png"
  },
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_title": "Riptide",
    "default_icon": {
      "16": "riptide-icon-16.png",
      "19": "riptide-icon-19.png",
      "32": "riptide-icon-32.png",
      "38": "riptide-icon-38.png"
    },
    "default_popup": "popup.html"
  }
}
