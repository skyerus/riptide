+"""Riptide cached-history negotiation over the real ACP projection."""
+import asyncio
+
+import pytest
+
+from acp_adapter.gateway_server import _history_checkpoint
+from tests.acp_adapter.test_gateway_sessions import editor, viewer
+
+
+def test_history_checkpoints_only_append_at_a_turn_boundary():
+    history = [{"role": "user", "content": "first"}, {"role": "assistant", "content": "reply"}]
+    checkpoint, reused = _history_checkpoint(history, {})
+    assert not reused
+    assert _history_checkpoint(history, checkpoint) == (checkpoint, True)
+    assert _history_checkpoint(history + [{"role": "user", "content": "next"}], checkpoint)[1]
+    assert not _history_checkpoint(history + [{"role": "assistant", "content": "continued"}], checkpoint)[1]
+    assert not _history_checkpoint([{**history[0], "content": "edited"}, history[1]], checkpoint)[1]
+
+
+@pytest.mark.asyncio
+async def test_fast_resume_fetches_recent_rows_and_replays_only_new_turns(daemon, tmp_path, model_peer):
+    cwd = str(tmp_path)
+    async with viewer(daemon) as ws:
+        sid = (await ws.rpc("session.create", request_id="riptide-fast", source="cli", cwd=cwd))["session_id"]
+    params = {"sessionId": sid, "cwd": cwd, "mcpServers": []}
+
+    async def send(acp, text):
+        result = await acp.rpc("session/prompt", sessionId=sid, prompt=[{"type": "text", "text": text}])
+        assert result.get("result", {}).get("stopReason") == "end_turn", result
+
+    def history(acp, start=0):
+        return [f["params"]["update"].get("content", {}).get("text") for f in acp.frames[start:]
+                if f.get("method") == "_riptide/session/history"]
+
+    async with editor(daemon, tmp_path) as acp:
+        init = await acp.rpc("initialize", protocolVersion=1, clientCapabilities={})
+        assert init["result"]["agentCapabilities"]["_meta"]["app.riptide.fastResume"] == 1
+        assert "result" in await acp.rpc("session/load", **params)
+        await send(acp, "WS_SHARED history before disconnect")
+        first = await acp.rpc("_riptide/session/resume", **params)
+        assert first["result"]["reuseHistory"] is False
+        checkpoint = first["result"]["checkpoint"]
+        assert "WS_SHARED history before disconnect" in history(acp)
+        await send(acp, "WS_SHARED history after disconnect")
+
+    async with editor(daemon, tmp_path) as acp:
+        await acp.rpc("initialize", protocolVersion=1, clientCapabilities={})
+        wrong = await acp.rpc("_riptide/session/recent", sessionId=sid, cwd=str(tmp_path / "different"))
+        assert wrong["error"]["code"] == -32602
+        start = len(acp.frames)
+        recent, resumed = await asyncio.gather(
+            acp.rpc("_riptide/session/recent", sessionId=sid, cwd=cwd),
+            acp.rpc("_riptide/session/resume", **params, checkpoint=checkpoint),
+        )
+        assert any(u["content"]["text"] == "WS_SHARED history after disconnect"
+                   for u in recent["result"]["updates"])
+        assert resumed["result"]["reuseHistory"] is True, resumed
+        assert "WS_SHARED history after disconnect" in history(acp, start)
+        assert "WS_SHARED history before disconnect" not in history(acp, start)
+
+        start = len(acp.frames)
+        same = await acp.rpc("_riptide/session/resume", **params, checkpoint=resumed["result"]["checkpoint"])
+        assert same["result"]["reuseHistory"] is True
+        assert history(acp, start) == []
+        stale = {**checkpoint, "digest": "0" * 64}
+        start = len(acp.frames)
+        result = await acp.rpc("_riptide/session/resume", **params, checkpoint=stale)
+        assert result["result"]["reuseHistory"] is False
+        assert "WS_SHARED history before disconnect" in history(acp, start)
