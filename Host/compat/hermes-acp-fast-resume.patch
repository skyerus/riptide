+def _history_checkpoint(rows, checkpoint):
+    """Only append deltas after an exact stored prefix and at a turn boundary."""
+    digest = hashlib.sha256()
+    count = checkpoint.get("rows", -1)
+    expected = checkpoint.get("digest")
+    reused = False
+    for index, row in enumerate(rows):
+        if index == count and row.get("role") == "user":
+            reused = digest.hexdigest() == expected
+        digest.update(json.dumps(row, sort_keys=True, separators=(",", ":")).encode())
+        digest.update(b"\n")
+    result = {"rows": len(rows), "digest": digest.hexdigest()}
+    reused = reused or (count == len(rows) and result["digest"] == expected)
+    return result, reused
+
+
+def _riptide_history_update(update):
+    """Project only the fields the app renders and can safely retain in its cache."""
+    packet = update.model_dump(mode="json", by_alias=True, exclude_none=True)
+    kind = packet["sessionUpdate"]
+    if kind == "agent_thought_chunk":
+        return {"sessionUpdate": kind, "content": {"type": "text", "text": "."}}
+    if kind in ("tool_call", "tool_call_update"):
+        return {key: packet[key] for key in ("sessionUpdate", "toolCallId", "title", "status") if key in packet}
+    return packet


