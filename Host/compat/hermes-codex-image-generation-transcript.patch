diff --git a/tests/acp_adapter/test_riptide_codex_image_generation.py b/tests/acp_adapter/test_riptide_codex_image_generation.py
new file mode 100644
--- /dev/null
+++ b/tests/acp_adapter/test_riptide_codex_image_generation.py
@@ -0,0 +1,52 @@
+"""Riptide's stored Codex image events replay as concise status messages."""
+
+import hashlib
+import json
+
+from acp_adapter.gateway_server import _history_checkpoint
+from acp_adapter.server import _history_replay_updates
+
+NOTICE = "Image generated on the agent host."
+IMAGE = {
+    "type": "imageGeneration", "id": "exec-image", "status": "completed",
+    "revisedPrompt": "A simple avatar", "result": "iVBORw0KGgo" * 500,
+    "savedPath": "/fixture/avatar.png",
+}
+TRUNCATED = "[codex imageGeneration] " + json.dumps(IMAGE)[:1500]
+FAILED = "[codex imageGeneration] " + json.dumps({
+    **IMAGE, "status": "failed", "result": None, "failure": "Fixture detail",
+})
+
+
+def test_replay_converts_complete_and_truncated_records_but_keeps_surrounding_text():
+    quoted = f"The log included: {TRUNCATED}"
+    malformed = '[codex imageGeneration] {"type": "imageGeneration", "id": "clip"'
+    unrelated = '[codex imageGeneration] {"type": "agentMessage", "id": "fixture", "status": "completed"}'
+    rows = [{"role": "user", "content": "Generate a minimal avatar."}] + [
+        {"role": "assistant", "content": text}
+        for text in (TRUNCATED, FAILED, "That is the preview.", quoted, malformed, unrelated)
+    ] + [{"role": "user", "content": TRUNCATED}]
+    updates = list(_history_replay_updates(rows))
+    assert [update.content.text for update in updates] == [
+        "Generate a minimal avatar.", NOTICE, "Image generation failed.",
+        "That is the preview.", quoted, malformed, unrelated, TRUNCATED,
+    ]
+    assert rows[1]["content"] == TRUNCATED
+
+
+def unpatched_checkpoint(rows):
+    body = "".join(json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n" for row in rows)
+    return {"rows": len(rows), "digest": hashlib.sha256(body.encode()).hexdigest()}
+
+
+def test_fast_resume_refreshes_only_a_prefix_caching_a_raw_image_record():
+    ordinary = [{"role": "user", "content": "Hi"}, {"role": "assistant", "content": "Hello."}]
+    history = ordinary + [
+        {"role": "user", "content": "Generate an avatar."},
+        {"role": "assistant", "content": TRUNCATED},
+    ]
+    current, reused = _history_checkpoint(history, unpatched_checkpoint(history))
+    assert not reused
+    assert _history_checkpoint(history, current) == (current, True)
+    assert _history_checkpoint(history, unpatched_checkpoint(ordinary)) == (current, True)
+    assert _history_checkpoint(ordinary, unpatched_checkpoint(ordinary))[1]
