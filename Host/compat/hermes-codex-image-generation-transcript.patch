+def legacy_image_generation_notice(text: str) -> str | None:
+    """Recognize intact or clipped image records produced by the opaque projector."""
+    prefix = f"[codex {_IMAGE_GENERATION}] "
+    if not text.startswith(prefix):
+        return None
+    payload = text[len(prefix):]
+    if len(payload) > _OPAQUE_PAYLOAD_LIMIT:
+        return None
+    try:
+        item = json.loads(payload)
+    except (ValueError, RecursionError):
+        match = _TRUNCATED_IMAGE_GENERATION.match(payload) if len(payload) == _OPAQUE_PAYLOAD_LIMIT else None
+        if not match:
+            return None
+        status = match[1]
+    else:
+        if (not isinstance(item, dict) or item.get("type") != _IMAGE_GENERATION
+                or not isinstance(item.get("id"), str) or not item["id"]
+                or not isinstance(item.get("status"), str)):
+            return None
+        status = item["status"]
+    return _IMAGE_GENERATION_STATUSES.get(status, "Image generation update.")
+
