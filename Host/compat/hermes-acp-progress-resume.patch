diff --git a/tests/acp_adapter/test_riptide_progress_resume.py b/tests/acp_adapter/test_riptide_progress_resume.py
new file mode 100644
index 0000000..91c0eec
--- /dev/null
+++ b/tests/acp_adapter/test_riptide_progress_resume.py
@@ -0,0 +1,67 @@
+from unittest.mock import AsyncMock
+
+import pytest
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from agent.transports.codex_event_projector import ASSISTANT_PROGRESS
+from gateway.session_events import SessionEvents
+from tests.acp_adapter.test_gateway_sessions import viewer
+from tui_gateway.contracts.canonical_sessions import CanonicalSnapshot
+
+
+@pytest.mark.asyncio
+async def test_resume_snapshot_matches_the_canonical_wire_contract(daemon, tmp_path):
+    async with viewer(daemon) as client:
+        session = await client.rpc("session.create", request_id="riptide-progress", cwd=str(tmp_path))
+        response = await client.rpc("session.resume", session_id=session["session_id"])
+    snapshot = CanonicalSnapshot.model_validate(response)
+    assert snapshot.context_compaction is None
+    assert snapshot.assistant_progress is None
+
+
+def test_only_latest_visible_progress_is_kept_for_the_active_generation():
+    events = SessionEvents()
+    with events.lock:
+        events.note_progress(1, "message.interim", {"codex_item_id": "first", "text": "Starting"})
+        events.note_progress(1, "message.interim", {"codex_item_id": "latest", "text": "Checking"})
+        events.note_progress(1, "message.interim", {"codex_item_id": "hidden", "text": ""})
+        events.note_progress(1, "message.interim", {"text": "An unclassified reply"})
+    assert events.assistant_progress_for(1) == {"id": "latest", "text": "Checking"}
+    assert events.assistant_progress_for(None) is None
+    assert events.assistant_progress_for(2) is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("opt_in,still_active,newer,restored", [
+    (True, True, False, True),
+    (False, True, False, False),
+    (True, False, False, False),
+    (True, True, True, False),
+])
+async def test_resume_only_projects_current_opted_in_progress(opt_in, still_active, newer, restored):
+    adapter = GatewayACPAgent()
+    adapter._riptide_client = True
+    adapter._assistant_progress = opt_in
+    adapter._conn = AsyncMock()
+    snapshot = {
+        "pending": [{"admission_id": "turn", "status": "started", "execution_generation": 4}],
+        "execution_generation": 4,
+        "assistant_progress": {"id": "progress", "text": "Checking the current changes."},
+    }
+    await adapter._adopt("session", snapshot)
+    if not still_active:
+        await adapter._finish_riptide_turn("session", "turn")
+    if newer:
+        await adapter._project({
+            "type": "message.interim", "session_id": "session", "admission_id": "turn",
+            "payload": {"codex_item_id": "newer", "text": "The checks passed."},
+        })
+    adapter._conn.reset_mock()
+    await adapter._restore_assistant_progress("session", "session", snapshot)
+    if restored:
+        adapter._conn.session_update.assert_awaited_once()
+        update = adapter._conn.session_update.await_args.kwargs["update"]
+        assert update.content.text == "Checking the current changes."
+        assert update.field_meta == {ASSISTANT_PROGRESS: True}
+    else:
+        adapter._conn.session_update.assert_not_called()
