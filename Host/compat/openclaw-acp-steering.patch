+  async steer(sessionId: string, text: string): Promise<{ status: "steered" | "idle" }> {
+    if (!this.sessionStore.getSession(sessionId)) {
+      throw new Error("Open the conversation before steering it.");
+    }
+    const pending = this.pendingPrompts.get(sessionId);
+    if (!pending) {
+      if (this.pendingPromptAdmissions.has(sessionId)) {
+        throw new Error("OpenClaw is still starting this turn. Try again in a moment.");
+      }
+      return { status: "idle" };
+    }
+
+    // Authorize through the Gateway as the same caller that submitted this
+    // prompt. Only target a run that belongs to this ACP connection.
+    const { target } = await this.gateway.request<{
+      target: { sessionId: string; runId: string } | null;
+    }>("sessions.steerTarget", { sessionKey: pending.sessionKey });
+    if (!target && !this.getPendingPrompt(sessionId, pending.idempotencyKey)) {
+      return { status: "idle" };
+    }
+    if (!target || target.runId !== pending.idempotencyKey) {
+      throw new Error("OpenClaw cannot steer this turn.");
+    }
+    const reply = await this.gateway.request<{ status: string }>("sessions.steerActive", {
+      sessionKey: pending.sessionKey,
+      sessionId: target.sessionId,
+      runId: target.runId,
+      message: text,
+      idempotencyKey: randomUUID(),
+    });
+    if (reply.status !== "accepted") {
+      throw new Error("OpenClaw did not confirm steering for this turn.");
+    }
+    return { status: "steered" };
   }

