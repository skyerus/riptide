diff --git a/tests/acp_adapter/test_riptide_codex_image_view.py b/tests/acp_adapter/test_riptide_codex_image_view.py
new file mode 100644
index 0000000..6db7574
--- /dev/null
+++ b/tests/acp_adapter/test_riptide_codex_image_view.py
@@ -0,0 +1,42 @@
+"""Screenshot activity stays out of the assistant conversation."""
+
+import json
+
+from acp_adapter.server import _history_replay_updates
+from agent.transports.codex_event_projector import CodexEventProjector
+
+
+IMAGE_VIEW = {"type": "imageView", "id": "exec-fixture",
+              "path": "/fixture/browser-screenshot.png", "startedAtMs": 1, "completedAtMs": 1}
+
+
+def test_screenshot_item_does_not_materialize_as_an_assistant_message():
+    projector = CodexEventProjector()
+    method = "item/completed"
+    screenshot = projector.project({"method": method, "params": {"item": IMAGE_VIEW}})
+    assert screenshot.messages == []
+    assert screenshot.final_text is None
+    final = projector.project({"method": method, "params": {"item": {
+        "type": "agentMessage", "id": "reply", "phase": "final_answer", "text": "Browser checked.",
+    }}})
+    assert final.messages == [{"role": "assistant", "content": "Browser checked."}]
+    assert final.final_text == "Browser checked."
+
+
+def test_replay_omits_only_legacy_image_view_records():
+    legacy = "[codex imageView] " + json.dumps(IMAGE_VIEW)
+    quoted = "Here is the record: " + legacy
+    incomplete = "[codex imageView] This is a regular note."
+    other_item = '[codex imageView] {"type": "agentMessage", "id": "text", "path": "source"}'
+    updates = list(_history_replay_updates([
+        {"role": "user", "content": "Check the example page."},
+        {"role": "assistant", "content": legacy},
+        {"role": "assistant", "content": "Browser checked."},
+        {"role": "assistant", "content": incomplete},
+        {"role": "assistant", "content": other_item},
+        {"role": "assistant", "content": quoted},
+        {"role": "user", "content": legacy},
+    ]))
+    assert [update.content.text for update in updates] == [
+        "Check the example page.", "Browser checked.", incomplete, other_item, quoted, legacy,
+    ]
