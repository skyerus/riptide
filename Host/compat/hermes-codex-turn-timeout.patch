+@pytest.mark.asyncio
+@pytest.mark.parametrize("own_prompt", [True, False])
+async def test_codex_timeout_has_structured_acp_status_for_each_viewer(own_prompt):
+    agent = agent_with_admission()
+    task = None
+    if own_prompt:
+        task = asyncio.create_task(agent.prompt([TextContentBlock(type="text", text="hello")], "s"))
+        await asyncio.sleep(0)
+    await agent._project({
+        "session_id": "s", "type": "message.complete", "admission_id": "current",
+        "payload": {"outcome": "failed", "failure_reason": "codex_turn_timeout"},
+    })
+    if task is not None:
+        response = await asyncio.wait_for(task, 2)
+        assert response.field_meta == {"app.riptide.turnFailure": "timeout"}
+        agent._conn.session_update.assert_not_awaited()
+    else:
+        agent._conn.session_update.assert_awaited_once()
+        assert agent._conn.session_update.await_args.kwargs["update"].field_meta == {
+            "app.riptide.turnFailure": "timeout",
+        }
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("redirect", [
+    {"status": "rejected", "delivered": False},
+    {"status": "rejected"},
+    {"status": "redirected"},
+])
+async def test_only_confirmed_undelivered_redirect_allows_resubmit(redirect):
+    import acp
+
+    agent = agent_with_admission()
+    agent._admissions["s"] = "current"
+    agent._gateway.rpc.side_effect = [
+        {"status": "started", "execution_generation": 1},
+        redirect,
+    ]
+    if redirect == {"status": "rejected"}:
+        with pytest.raises(acp.RequestError):
+            await agent.ext_method("riptide/session/steer", {"sessionId": "s", "text": "follow-up"})
+    else:
+        result = await agent.ext_method("riptide/session/steer", {"sessionId": "s", "text": "follow-up"})
+        assert result == ({"status": "idle", "delivered": False} if redirect["status"] == "rejected"
+                          else {"status": "steered"})
+    assert agent._gateway.rpc.await_count == 2
+
+
