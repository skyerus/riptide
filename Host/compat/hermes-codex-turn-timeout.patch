+@pytest.mark.parametrize("progress_thread,hard_limit,expected_stop", [
+    ("thread-fake-001", 3600.0, 1000.0),
+    ("unrelated-thread", 3600.0, 600.0),
+    ("thread-fake-001", 900.0, 900.0),
+])
+def test_codex_turn_time_budget_tracks_scoped_progress(monkeypatch, progress_thread, hard_limit, expected_stop):
+    client = FakeClient()
+    session = make_session(client)
+    now = 0.0
+    scheduled = iter([
+        (400.0, {"method": "item/started", "params": {"threadId": progress_thread}}),
+        (700.0, {"method": "item/completed", "params": {"threadId": progress_thread}}),
+        (1000.0, {"method": "turn/completed", "params": {"turn": {"id": "turn-fake-001"}}}),
+    ])
+    event_at, note = next(scheduled)
+
+    def take_notification(timeout):
+        nonlocal now, event_at, note
+        now = min(now + timeout, event_at)
+        if now < event_at:
+            return None
+        ready = note
+        event_at, note = next(scheduled, (float("inf"), None))
+        return ready
+
+    monkeypatch.setattr(session_mod, "time", SimpleNamespace(monotonic=lambda: now))
+    monkeypatch.setattr(client, "take_notification", take_notification)
+    result = session.run_turn("Review a project", max_turn_duration=hard_limit)
+    assert now == expected_stop
+    assert result.timed_out == (expected_stop < 1000)
+    assert result.should_retire == result.timed_out
+    assert sum(method == "turn/interrupt" for method, _ in client.requests) == int(result.timed_out)
+    if expected_stop == hard_limit:
+        assert "maximum duration" in result.error
