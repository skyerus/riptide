diff --git a/tests/acp_adapter/test_riptide_service_tier_restart.py b/tests/acp_adapter/test_riptide_service_tier_restart.py
new file mode 100644
index 0000000..7cd6bba
--- /dev/null
+++ b/tests/acp_adapter/test_riptide_service_tier_restart.py
@@ -0,0 +1,62 @@
+"""ACP speed choices survive a gateway restart without changing the profile default."""
+import json
+from pathlib import Path
+
+import pytest
+
+from tests.acp_adapter.test_gateway_service_tier import _tier
+from tests.acp_adapter.test_gateway_sessions import editor, viewer
+from tests.gateway.fixtures.local_recovery_probe import child_env, daemon
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(('default', 'selected'), [('normal', 'fast'), ('fast', 'normal')])
+async def test_chat_speed_survives_gateway_restart(tmp_path, model_peer, default, selected):
+    root = Path(__file__).resolve().parents[2]
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir(mode=0o700)
+    user.mkdir()
+    model_url = f'http://127.0.0.1:{model_peer.server_port}/v1'
+    config = {
+        'gateway': {'multiplex_profiles': False},
+        'agent': {'service_tier': default},
+        'model': {'provider': 'openai', 'default': 'gpt-6.1-sol', 'base_url': 'https://api.openai.com/v1'},
+        'model_catalog': {'enabled': False},
+        'models_dev': {'url': model_url.removesuffix('/v1') + '/models-dev-offline'},
+    }
+    config_path = home / 'config.yaml'
+    config_path.write_text(json.dumps(config))
+    original_config = config_path.read_bytes()
+    env = child_env()
+    env.update(HOME=str(user), USERPROFILE=str(user), HERMES_HOME=str(home),
+               PYTHONPATH=str(root), PYTHONUNBUFFERED='1', OPENAI_API_KEY='loopback-only')
+
+    async def open_editor(acp):
+        assert 'result' in await acp.rpc('initialize', protocolVersion=1, clientCapabilities={})
+
+    async def open_chat(acp, method, **params):
+        return (await acp.rpc(method, cwd=str(tmp_path), mcpServers=[], **params))['result']
+
+    with daemon(root, home, env, barrier=False) as (first, descriptor):
+        async with editor((home, descriptor, env, root), tmp_path) as acp:
+            await open_editor(acp)
+            chat = await open_chat(acp, 'session/new')
+            sibling = await open_chat(acp, 'session/new')
+            assert _tier(chat)['currentValue'] == default
+            assert _tier(sibling)['currentValue'] == default
+            changed = await acp.rpc('session/set_config_option', sessionId=chat['sessionId'],
+                                    configId='service_tier', value=selected)
+            assert _tier(changed['result'])['currentValue'] == selected
+
+    with daemon(root, home, env, barrier=False) as (second, descriptor):
+        assert second.pid != first.pid
+        connection = home, descriptor, env, root
+        async with editor(connection, tmp_path) as acp, viewer(connection) as ws:
+            await open_editor(acp)
+            for row, expected in ((chat, selected), (sibling, default)):
+                sid = row['sessionId']
+                restored = await open_chat(acp, 'session/load', sessionId=sid)
+                assert _tier(restored)['currentValue'] == expected
+                assert (await ws.rpc('config.get', session_id=sid, key='service_tier'))['value'] == expected
+    assert config_path.read_bytes() == original_config
+    assert not model_peer.requests
