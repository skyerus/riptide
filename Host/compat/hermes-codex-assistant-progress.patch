diff --git a/tests/acp_adapter/test_riptide_assistant_progress.py b/tests/acp_adapter/test_riptide_assistant_progress.py
new file mode 100644
index 0000000..1c1c862
--- /dev/null
+++ b/tests/acp_adapter/test_riptide_assistant_progress.py
@@ -0,0 +1,82 @@
+"""Codex message identity and phase survive the gateway's ACP projection."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from agent.codex_runtime import codex_stream_item_id, make_codex_app_server_event_bridge
+from agent.transports.codex_event_projector import ASSISTANT_PROGRESS, CodexEventProjector
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream_progress,tool_before_completion", [(False, False), (True, False), (True, True)])
+async def test_progress_and_identical_final_use_distinct_messages(stream_progress, tool_before_completion):
+    text = "I checked the saved settings."
+    frames = []
+
+    def frame(kind, **payload):
+        frames.append({"type": kind, "session_id": "chat", "admission_id": "turn", "payload": payload})
+
+    codex = SimpleNamespace(
+        _fire_stream_delta=lambda value: frame("message.delta", text=value, codex_item_id=codex_stream_item_id.get()),
+        _visible_commentary=lambda value: value,
+        _interim_content_fully_streamed=lambda _: stream_progress,
+        codex_commentary_callback=lambda item, value, streamed, _enabled: frame(
+            "message.interim", text=value, already_streamed=streamed, codex_item_id=item),
+    )
+    bridge = make_codex_app_server_event_bridge(codex)
+    projector = CodexEventProjector()
+    if stream_progress:
+        bridge({"method": "item/agentMessage/delta", "params": {"itemId": "progress", "delta": text}})
+    if tool_before_completion:
+        frame("tool.start", tool_call_id="tool", tool_name="test tool")
+    commentary = {"method": "item/completed", "params": {"item": {
+        "type": "agentMessage", "id": "progress", "phase": "commentary", "text": text}}}
+    bridge(commentary)
+    progress_result = projector.project(commentary)
+    assert progress_result.final_text is None
+    assert progress_result.messages[0]["display_metadata"] == {ASSISTANT_PROGRESS: True}
+    frame("message.complete", text=text, outcome="completed")
+
+    acp = GatewayACPAgent()
+    acp._conn = AsyncMock()
+    acp._observe_client_message(SimpleNamespace(direction="incoming", message={"method": "initialize", "params": {
+        "clientInfo": {"name": "riptide"}, "clientCapabilities": {"_meta": {ASSISTANT_PROGRESS: True}}
+    }}))
+    for event in frames:
+        await acp._project(event)
+    updates = [call.kwargs["update"] for call in acp._conn.session_update.await_args_list
+               if call.kwargs["update"].session_update == "agent_message_chunk"]
+    assert len(updates) == (3 if stream_progress else 2)
+    progress, final = updates[-2:]
+    assert progress.field_meta == {ASSISTANT_PROGRESS: True}
+    assert final.field_meta is None
+    assert progress.content.text == final.content.text == text
+    assert progress.message_id != final.message_id
+    if stream_progress:
+        assert progress.message_id == updates[0].message_id
+
+
+@pytest.mark.asyncio
+async def test_reopen_keeps_phase_unknown_history_and_final_text():
+    acp = GatewayACPAgent()
+    acp._assistant_progress = True
+    acp._conn = AsyncMock()
+    gateway = AsyncMock()
+    gateway.rpc.return_value = {"messages": [
+        {"row_id": 1, "role": "assistant", "content": "Older saved answer."},
+        {"row_id": 2, "role": "assistant", "content": "Checking settings.",
+         "display_metadata": {ASSISTANT_PROGRESS: True}},
+        {"row_id": 3, "role": "assistant", "content": "Settings checked."},
+    ]}
+    acp._client = AsyncMock(return_value=gateway)
+    acp._attach_info = AsyncMock(return_value={"cwd": "/tmp"})
+    acp._adopt = AsyncMock()
+    acp._notify_unknown = AsyncMock()
+    acp._request_live_reasoning = AsyncMock()
+    acp._session_fields = AsyncMock()
+    await acp._resume("/tmp", "chat", None)
+    updates = [call.kwargs["update"].content.text for call in acp._conn.session_update.await_args_list]
+    assert updates == ["Older saved answer.", "Settings checked."]
