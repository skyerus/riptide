+def answer_riptide_form(params, clarify):
+    """Translate the shared MCP form to the gateway's current turn-bound ACP approval."""
+    declined = {'action': 'decline', 'content': None, '_meta': None}
+    if not callable(clarify) or params.get('mode') != 'form':
+        return declined
+    server = params.get('serverName')
+    fields_by_server = {'riptide_pairing': {'pair'}, 'riptide_hermes_browser': {'browser', 'browser_input'}}
+    if server not in fields_by_server or not any(arg.startswith(f'mcp_servers.{server}.command=')
+                                     for arg in current_riptide_mcp_args()):
+        return declined
+    schema = params.get('requestedSchema')
+    fields = schema.get('properties') if isinstance(schema, dict) else None
+    if not isinstance(fields, dict) or len(fields) != 1 or not fields.keys() <= fields_by_server[server]:
+        return declined
+    field_name, field = next(iter(fields.items()))
+    choices = field.get('enum') if isinstance(field, dict) and field.get('type') == 'string' else None
+    message = params.get('message')
+    if (not isinstance(message, str) or not 0 < len(message) <= 200 or not isinstance(choices, list)
+            or len(choices) != 1 or not isinstance(choices[0], str)):
+        return declined
+    if field_name == 'pair' and not re.fullmatch(r'Pair Hermes profile: [a-z0-9][a-z0-9_-]{0,63}', choices[0]):
+        return declined
+    browser_choices = {'browser': 'Browser handoff complete', 'browser_input': 'Allow Chrome input'}
+    if field_name in browser_choices and choices[0] != browser_choices[field_name]:
+        return declined
+    try:
+        reply = clarify([{'qid': 'q0', 'question': message, 'choices': choices,
+                          'choices_offered': choices, 'multi_select': False}])
+    except Exception:
+        logger.exception('Could not deliver the Riptide form')
+        return {**declined, 'action': 'cancel'}
+    if not isinstance(reply, dict) or reply.get('outcome') != 'submitted':
+        return {**declined, 'action': 'cancel'}
+    if (reply.get('answers') or {}).get('q0') == choices[0]:
+        return {'action': 'accept', 'content': {field_name: choices[0]}, '_meta': None}
+    return declined
