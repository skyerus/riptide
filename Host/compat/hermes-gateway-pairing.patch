+def _riptide_connector(spec):
+    # Only forward the known host connectors from the admitted editor's manifest.
+    if spec.get('type', 'stdio') != 'stdio' or spec.get('env'):
+        return None
+    name, command, args = spec['name'], spec['command'], spec['args']
+    if (name == 'riptide_hermes_browser' and len(args) == 5
+            and Path(args[0]).name == 'hermes_browser_mcp.py'
+            and args[1::2] == ['--hermes-source', '--profile']
+            and all(Path(path).is_absolute() for path in (command, *args[::2]))):
+        return name
+    if len(args) != 3 or not all(Path(path).is_absolute() for path in (command, args[0], args[2])):
+        return None
+    signature = (Path(args[0]).name, args[1])
+    if name == 'riptide_pairing' and signature == ('agent_pairing_mcp.py', '--config'):
+        return name
+    if name == 'riptide_agent_profile' and signature == ('agent_profile.py', '--state'):
+        return name
+    return None
+
+
+@contextmanager
+def _riptide_mcp_scope(servers=(), connected=(), profile=None):
+    arguments = []
+    for index in connected:
+        spec = servers[index]
+        name = _riptide_connector(spec)
+        if name is None:
+            continue
+        settings = {'command': spec['command'], 'args': spec['args'], 'tool_timeout_sec': 90}
+        if name == 'riptide_pairing':
+            # Invoking these two tools only discovers targets or asks the phone for consent.
+            # The pairing form itself stays interactive even under Codex's approval settings.
+            settings.update(tool_timeout_sec=180, default_tools_approval_mode='approve',
+                            enabled_tools=['list_pairable_agents', 'request_agent_pairing'])
+        if name == 'riptide_hermes_browser':
+            if spec['args'][-1] != str(profile):
+                continue
+            settings.update(tool_timeout_sec=180, default_tools_approval_mode='approve',
+                            enabled_tools=['computer_use', 'chrome_handoff'])
+        if name == 'riptide_agent_profile':
+            settings.update(default_tools_approval_mode='approve', enabled_tools=['set_display_name'])
+        for key, value in settings.items():
+            arguments.extend(('-c', f'mcp_servers.{name}.{key}={_json(value)}'))
+    token = _RIPTIDE_MCP_ARGS.set(tuple(arguments))
+    try:
+        yield
+    finally:
+        _RIPTIDE_MCP_ARGS.reset(token)
+
+
+def current_riptide_mcp_args():
+    return _RIPTIDE_MCP_ARGS.get()
+
